<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_theme_background"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="360dp"
        android:layout_height="236dp"
        android:layout_marginStart="38dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/detail_preview"
        android:clipToOutline="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:foreground="@drawable/discovery_focus"
        android:nextFocusDown="@id/flag"
        android:nextFocusLeft="@id/video"
        android:nextFocusRight="@id/change"
        android:nextFocusUp="@id/video">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:layout_alignTop="@id/video"
        android:layout_alignBottom="@id/video"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="38dp"
        android:layout_toEndOf="@id/video"
        android:orientation="vertical"
        android:padding="0dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text"
            android:textSize="22sp"
            tools:text="慶餘年第二季" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/site"
                android:layout_width="0dp"
                android:layout_weight="1.45"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/tv_theme_text_secondary"
                android:textSize="15sp"
                tools:text="站源：泥巴" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/year"
                android:layout_width="0dp"
                android:layout_weight="0.85"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/tv_theme_text_secondary"
                android:textSize="15sp"
                tools:text="年份：2022" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/area"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/tv_theme_text_secondary"
                android:textSize="15sp"
                tools:text="地区：中国大陆" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/type"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/tv_theme_text_secondary"
                android:textSize="15sp"
                tools:text="类型：喜剧" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/actor"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text_secondary"
            android:textSize="15sp"
            tools:text="演员：FongMi" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/director"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text_secondary"
            android:textSize="15sp"
            tools:text="导演：FongMi" />

        <TextView
            android:id="@+id/playAddress"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="播放地址：https://…" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/tv_theme_text"
            android:textSize="15sp"
            tools:text="内容简介：这里显示来自站源的真实剧情简介，超过首屏的内容可通过内容简介打开完整文本。" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/change"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/detail_action_blue"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:nextFocusDown="@id/flag"
                android:nextFocusLeft="@id/video"
                android:nextFocusRight="@id/reverse"
                android:nextFocusUp="@id/video"
                android:singleLine="true"
                android:text="快速搜索"
                android:textColor="@color/tv_theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/reverse"
                style="@style/SearchControl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/detail_action_green"
                android:nextFocusDown="@id/flag"
                android:nextFocusLeft="@id/change"
                android:nextFocusRight="@id/keep"
                android:nextFocusUp="@id/video"
                android:text="倒序"
                android:textSize="15sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/keep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/detail_action_blue"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:nextFocusDown="@id/flag"
                android:nextFocusLeft="@id/reverse"
                android:nextFocusRight="@id/content"
                android:nextFocusUp="@id/video"
                android:singleLine="true"
                android:text="@string/keep"
                android:textColor="@color/tv_theme_text"
                android:textSize="15sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/detail_action_green"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:nextFocusDown="@id/flag"
                android:nextFocusLeft="@id/keep"
                android:nextFocusRight="@id/content"
                android:nextFocusUp="@id/video"
                android:singleLine="true"
                android:text="@string/detail_summary_action"
                android:textColor="@color/tv_theme_text"
                android:textSize="15sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/video"
        android:layout_marginStart="38dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="38dp"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/flagSection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">
            <androidx.leanback.widget.HorizontalGridView android:id="@+id/flag" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:visibility="gone" tools:visibility="visible" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:id="@+id/episodeSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">
            <com.fongmi.android.tv.ui.custom.EpisodeGridView
                android:id="@+id/episode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/quickSection"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="其他来源" android:textColor="@color/tv_theme_text_secondary" android:textSize="12sp" />
            <androidx.leanback.widget.HorizontalGridView android:id="@+id/quick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:visibility="gone" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.fongmi.android.tv.ui.custom.ProgressLayout>
