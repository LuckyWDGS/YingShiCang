<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
  <androidx.appcompat.widget.LinearLayoutCompat android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="32dp" android:paddingTop="18dp" android:paddingEnd="32dp" android:paddingBottom="12dp">
      <androidx.appcompat.widget.AppCompatImageView android:id="@+id/logo" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="10dp" android:src="@drawable/ysc_icon" />
      <com.fongmi.android.tv.ui.custom.CustomTitleView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:layout_weight="1" android:ellipsize="marquee" android:focusable="false" android:singleLine="true" android:text="@string/app_name" android:textColor="@color/tv_theme_text" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical" android:focusable="true" android:clickable="true" android:background="@drawable/home_shortcut" android:paddingHorizontal="6dp">
          <com.fongmi.android.tv.ui.custom.AnimatedWeatherView android:id="@+id/weatherIcon" android:layout_width="36dp" android:layout_height="28dp" android:importantForAccessibility="no" />
          <TextView android:id="@+id/weatherInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—°C" android:textColor="@color/tv_theme_text_secondary" android:textSize="12sp" android:layout_marginStart="3dp" android:maxWidth="160dp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textColor="@color/tv_theme_text_secondary" android:fontFeatureSettings="tnum" android:textSize="12sp" tools:text="2026年9月27日 20:18" />
      </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout android:id="@+id/categories" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="32dp">
      <com.google.android.material.textview.MaterialTextView android:id="@+id/home" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:paddingHorizontal="8dp" android:gravity="center" android:background="@drawable/home_category" android:focusable="true" android:focusableInTouchMode="false" android:text="主页" android:textColor="@color/home_category_text" android:textSize="16sp" android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/discoveryStatusRow" android:layout_width="match_parent" android:layout_height="28dp" android:paddingHorizontal="32dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
      <TextView android:id="@+id/discoveryStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tv_theme_text_secondary" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="36dp" android:paddingHorizontal="32dp" android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
    <com.fongmi.android.tv.ui.custom.ProgressLayout android:id="@+id/progressLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="32dp" android:paddingTop="8dp" android:paddingEnd="32dp" android:paddingBottom="24dp" android:descendantFocusability="afterDescendants" />
    </com.fongmi.android.tv.ui.custom.ProgressLayout>
  </androidx.appcompat.widget.LinearLayoutCompat>
  <ScrollView android:id="@+id/filterPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:background="@drawable/discovery_filter_panel" android:elevation="10dp" android:fillViewport="false" android:focusable="false" android:visibility="gone">
    <LinearLayout android:id="@+id/filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="32dp" android:paddingTop="10dp" android:paddingBottom="12dp" android:orientation="vertical" />
  </ScrollView>
</FrameLayout>
