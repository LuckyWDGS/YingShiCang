<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="#050505" android:paddingStart="15dp" android:paddingEnd="10dp" android:paddingTop="15dp" android:paddingBottom="8dp">
    <LinearLayout android:id="@+id/recordLayout" android:layout_width="0dp" android:layout_weight="24" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="37dp">
            <TextView style="@style/SearchBlackKey" android:layout_width="0dp" android:layout_weight="1" android:text="搜索历史" android:focusable="false" android:background="@drawable/search_black_label" />
            <TextView android:id="@+id/clearHistory" style="@style/SearchBlackKey" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="清空" android:nextFocusUp="@id/clearHistory" />
        </LinearLayout>
        <TextView android:id="@+id/emptyHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingStart="7dp" android:text="暂无搜索记录" android:textColor="#6E6E6E" android:textSize="14sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recordRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginStart="7dp" android:overScrollMode="never" android:scrollbars="none" />
        <TextView android:id="@+id/historyTip" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="7dp" android:text="长按记录可单独删除" android:textColor="#5C5C5C" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="31" android:layout_height="match_parent" android:layout_marginHorizontal="15dp" android:orientation="vertical">
        <TextView android:id="@+id/source" style="@style/SearchBlackKey" android:text="指定搜索源" android:nextFocusUp="@id/source" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginTop="8dp">
            <com.fongmi.android.tv.ui.custom.CustomEditText android:id="@+id/keyword" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/search_black_input" android:hint="请输入要搜索的内容" android:singleLine="true" android:inputType="text" android:maxLength="255" android:imeOptions="actionSearch" android:focusable="true" android:focusableInTouchMode="true" android:textColor="#F5F5F5" android:textColorHint="#7A7A7A" android:textSize="16sp" android:nextFocusDown="@id/search" />
            <com.fongmi.android.tv.ui.custom.CustomMic android:id="@+id/mic" android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:padding="5dp" android:background="@drawable/search_black_key" android:src="@drawable/ic_search_mic" android:contentDescription="语音搜索" android:focusable="true" android:focusableInTouchMode="false" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginTop="8dp">
            <TextView android:id="@+id/search" style="@style/SearchBlackPrimary" android:layout_width="0dp" android:layout_weight="1" android:text="搜索" />
            <TextView android:id="@+id/clearInput" style="@style/SearchBlackKey" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="清空" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginTop="8dp">
            <TextView android:id="@+id/remote" style="@style/SearchBlackKey" android:layout_width="0dp" android:layout_weight="1" android:text="远程搜索" />
            <TextView android:id="@+id/backspace" style="@style/SearchBlackKey" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="删除" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginStart="-3dp" android:layout_marginEnd="-3dp" android:overScrollMode="never" app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" app:spanCount="6" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_weight="45" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/word" android:layout_width="match_parent" android:layout_height="37dp" android:gravity="center" android:text="热门搜索" android:textColor="#FFFFFF" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/searchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="4dp" android:textColor="#7A7A7A" android:textSize="13sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/hotGroups" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/SearchBlackHeading" android:text="电视榜" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/tvRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
                <TextView style="@style/SearchBlackHeading" android:text="电影榜" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/movieRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
                <TextView style="@style/SearchBlackHeading" android:text="综艺榜" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/varietyRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/wordRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
