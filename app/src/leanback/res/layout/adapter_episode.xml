<!-- Keep a TV-safe focus target while allowing both metadata and title to
     fit inside a readable row. MaterialTextView's default minimum height is
     cleared below; the 51dp minimum adds about 30 physical pixels on the
     280dpi LDPlayer target so long file labels no longer look stacked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="51dp"
    android:background="@drawable/detail_episode"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:minHeight="0dp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text_secondary"
            android:textSize="12sp"
            tools:text="[5.38GB]" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:minHeight="0dp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_theme_text"
            android:textSize="16sp"
            tools:text="01.mp4" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
