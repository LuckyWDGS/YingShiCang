<com.fongmi.android.tv.ui.custom.PosterFrame xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/discovery_card" android:foreground="@drawable/discovery_focus" android:clipToOutline="true" android:focusable="true" android:focusableInTouchMode="false">
