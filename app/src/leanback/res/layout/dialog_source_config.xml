<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/source_panel">
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="添加线路" android:textSize="20sp" android:textColor="#EDF5F8" />
    <TextView android:id="@+id/close" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="×" android:textSize="25sp" android:textColor="#A9BFCC" android:contentDescription="关闭" android:focusable="true" android:focusableInTouchMode="false" android:background="@drawable/source_field" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="192dp" android:layout_marginTop="18dp" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="156dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
      <ImageView android:id="@+id/code" android:layout_width="140dp" android:layout_height="140dp" android:background="#FFFFFF" android:scaleType="fitCenter" android:contentDescription="扫码添加线路" />
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="手机扫码添加" android:textColor="#D4E3EA" android:textSize="13sp" />
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginHorizontal="24dp" android:background="#283E4B" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="粘贴 TVbox 配置链接" android:textColor="#CEDFE7" android:textSize="15sp" />
      <com.fongmi.android.tv.ui.custom.CustomEditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:hint="https://…" android:singleLine="true" android:inputType="textUri" android:paddingHorizontal="12dp" android:background="@drawable/source_field" android:backgroundTint="@null" android:textColor="#EDF5F8" android:textColorHint="#809AAA" android:textSize="15sp" android:importantForAutofill="no" android:imeOptions="actionDone" android:nextFocusDown="@id/save" />
      <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="名称自动识别" android:textColor="#8CA9BA" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
      <TextView android:id="@+id/save" android:layout_width="match_parent" android:layout_height="40dp" android:text="添加" android:gravity="center" android:textColor="#102B35" android:textSize="15sp" android:background="@drawable/source_primary" android:focusable="true" android:focusableInTouchMode="false" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/source_field">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="电脑访问 · 同一局域网" android:textColor="#8CA9BA" android:textSize="11sp" />
      <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#D4E3EA" android:textSize="13sp" android:singleLine="true" />
    </LinearLayout>
    <TextView android:id="@+id/pairCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#A2E5EC" android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
