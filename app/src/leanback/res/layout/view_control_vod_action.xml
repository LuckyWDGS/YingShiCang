<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <!-- One row: the common controls share the width evenly (each its label plus an equal share), 更多 closes the row (user 2026-10-24). -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="52dp" android:gravity="center_vertical" android:orientation="horizontal">
 <HorizontalScrollView android:id="@+id/toolbar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="true"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="3dp"><com.google.android.material.textview.MaterialTextView android:id="@+id/next" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_next" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/prev" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_prev" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/reset" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_reset" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/replay" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_replay" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/episodes" style="@style/VodControl" android:layout_weight="1" android:text="@string/vod_episodes" android:layout_marginEnd="6dp"/><com.fongmi.android.tv.ui.custom.CustomUpDownView android:id="@+id/speed" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_speed" android:layout_marginEnd="6dp"/><com.fongmi.android.tv.ui.custom.CustomUpDownView android:id="@+id/opening" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_op" android:layout_marginEnd="6dp"/><com.fongmi.android.tv.ui.custom.CustomUpDownView android:id="@+id/ending" style="@style/VodControl" android:layout_weight="1" android:text="@string/play_ed" android:layout_marginEnd="6dp"/><com.fongmi.android.tv.ui.custom.CustomUpDownView android:id="@+id/text" style="@style/VodControl" android:text="@string/play_track_text" android:tag="3" android:layout_weight="1" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/danmaku" style="@style/VodControl" android:text="@string/danmaku" android:layout_weight="1" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/audio" style="@style/VodControl" android:text="@string/play_track_audio" android:tag="1" android:layout_weight="1" android:layout_marginEnd="6dp"/><com.google.android.material.textview.MaterialTextView android:id="@+id/scale" style="@style/VodControl" android:text="@string/play_scale" android:layout_weight="1" android:nextFocusRight="@id/more"/></LinearLayout></HorizontalScrollView>
 <com.google.android.material.textview.MaterialTextView android:id="@+id/more" style="@style/VodControl" android:nextFocusLeft="@id/scale" android:layout_marginStart="6dp" android:text="@string/vod_more"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/morePanel" android:layout_width="296dp" android:layout_height="match_parent" android:layout_gravity="end" android:layout_marginTop="76dp" android:layout_marginEnd="20dp" android:layout_marginBottom="108dp" android:background="@drawable/player_vod_panel" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
 <TextView android:layout_width="match_parent" android:layout_height="36dp" android:paddingStart="4dp" android:text="@string/vod_playback_options" android:textColor="#FFFFFF" android:textSize="20sp" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><GridLayout android:id="@+id/moreGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2"><com.google.android.material.textview.MaterialTextView android:id="@+id/player" style="@style/VodMoreControl" android:text="@string/play_exo"/><com.google.android.material.textview.MaterialTextView android:id="@+id/decode" style="@style/VodMoreControl" android:text="@string/play_decode"/><com.google.android.material.textview.MaterialTextView android:id="@+id/render" style="@style/VodMoreControl" android:text="@string/vod_render_surface"/><com.google.android.material.textview.MaterialTextView android:id="@+id/repeat" style="@style/VodMoreControl" android:text="@string/play_repeat"/><com.google.android.material.textview.MaterialTextView android:id="@+id/screenInfo" style="@style/VodMoreControl" android:text="@string/vod_info_on"/><com.google.android.material.textview.MaterialTextView android:id="@+id/netSpeed" style="@style/VodMoreControl" android:text="@string/vod_speed_off"/><com.google.android.material.textview.MaterialTextView android:id="@+id/parse" style="@style/VodMoreControl" android:text="@string/parse" android:visibility="gone"/><com.google.android.material.textview.MaterialTextView android:id="@+id/video" style="@style/VodMoreControl" android:text="@string/play_track_video" android:tag="2" android:visibility="gone"/><com.google.android.material.textview.MaterialTextView android:id="@+id/edition" style="@style/VodMoreControl" android:text="@string/play_edition" android:visibility="gone"/><com.google.android.material.textview.MaterialTextView android:id="@+id/chapter" style="@style/VodMoreControl" android:text="@string/play_chapter" android:visibility="gone"/></GridLayout></ScrollView></LinearLayout>
</FrameLayout>
