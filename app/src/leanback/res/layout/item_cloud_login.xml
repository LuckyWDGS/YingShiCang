<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/cloud_login_card"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:importantForAccessibility="yes"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/providerAccent"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/cloud_login_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badge"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:background="@drawable/cloud_login_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/tv_theme_text"
            android:textSize="12sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/provider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/tv_theme_text"
            android:textSize="16sp"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <TextView
        android:id="@+id/scanHint"
        android:layout_width="match_parent"
        android:layout_height="19dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/cloud_login_scan_hint"
        android:textColor="@color/tv_theme_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01" />

    <FrameLayout
        android:id="@+id/qrFrame"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/cloud_login_qr_mat"
        android:padding="9dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/tv_theme_selected" />

            <TextView
                android:id="@+id/notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/cloud_login_placeholder_loading"
                android:textColor="@color/tv_theme_primary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/cloud_login_status"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/cloud_login_loading"
        android:textColor="@color/tv_theme_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/retry"
        android:layout_width="128dp"
        android:layout_height="29dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/cloud_login_button"
        android:enabled="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/cloud_login_retry"
        android:textColor="@color/tv_theme_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
