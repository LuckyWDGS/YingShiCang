<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No underline on the open tab (user 2026-10-24); home_category_text marks it. -->
    <item android:state_focused="true"><shape><solid android:color="@color/tv_theme_selected"/><corners android:radius="8dp"/><stroke android:width="2dp" android:color="@color/tv_theme_focus_border"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_theme_control"/><corners android:radius="8dp"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/></shape></item>
</selector>
