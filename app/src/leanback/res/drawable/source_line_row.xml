<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#1B3644"/><corners android:radius="8dp"/><stroke android:width="2dp" android:color="#A2DFEA"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#19323F"/><corners android:radius="8dp"/><stroke android:width="1dp" android:color="#426772"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#263F4D"/><corners android:radius="8dp"/></shape></item>
    <item><shape><solid android:color="#0C1D28"/><corners android:radius="8dp"/><stroke android:width="1dp" android:color="#2A414F"/></shape></item>
</selector>
