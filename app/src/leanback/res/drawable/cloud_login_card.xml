<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:startColor="#3E4A56" android:endColor="#2A343E" />
            <corners android:radius="15dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#35414D" />
            <corners android:radius="15dp" />
            <stroke android:width="2dp" android:color="@color/tv_theme_selected_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#2B3540" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#6D7A86" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#2A323B" android:endColor="#1B222A" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#4C5864" />
        </shape>
    </item>
</selector>
