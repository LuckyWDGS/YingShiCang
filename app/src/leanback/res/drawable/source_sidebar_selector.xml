<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_theme_selected"/><corners android:radius="8dp"/><stroke android:width="2dp" android:color="@color/tv_theme_focus_border"/></shape></item>
    <item android:state_selected="true"><layer-list>
        <item><shape><solid android:color="@color/tv_theme_selected"/><corners android:radius="8dp"/></shape></item>
        <item android:width="2dp" android:gravity="left" android:top="10dp" android:bottom="10dp"><shape><solid android:color="@color/tv_theme_text"/></shape></item>
    </layer-list></item>
    <item><shape><solid android:color="#00000000"/></shape></item>
</selector>
