<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#2D4652"/><corners android:radius="6dp"/><stroke android:width="2dp" android:color="#B3DBE5"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#29434F"/><corners android:radius="6dp"/><stroke android:width="1dp" android:color="#6C98A6"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#344C59"/><corners android:radius="6dp"/></shape></item>
    <item><shape><solid android:color="#AD122B38"/><corners android:radius="6dp"/><stroke android:width="0.5dp" android:color="#2C4A59"/></shape></item>
</selector>
