<?xml version="1.0" encoding="utf-8"?>
<!-- The 4dp inset keeps room for the outer focus ring so focus never changes the layout. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><stroke android:width="2dp" android:color="@color/tv_theme_focus_border" /><corners android:radius="13dp" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/tv_theme_primary" /><corners android:radius="9dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <inset android:inset="4dp"><shape><solid android:color="@color/tv_theme_primary_pressed" /><corners android:radius="9dp" /></shape></inset>
    </item>
    <item>
        <inset android:inset="4dp"><shape><solid android:color="@color/tv_theme_primary" /><corners android:radius="9dp" /></shape></inset>
    </item>
</selector>
