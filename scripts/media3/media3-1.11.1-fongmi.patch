+ */
+package androidx.media3.mpvplayer.media;
+
+public final class MpvEndFileGuard {
+
+  private int pendingExpectedEnds;
+
+  public void expect() {
+    pendingExpectedEnds++;
+  }
+
+  public boolean consumeExpected() {
+    if (pendingExpectedEnds <= 0) {
+      return false;
+    }
+    pendingExpectedEnds--;
+    return true;
+  }
+
+  public void cancelExpected() {
+    if (pendingExpectedEnds > 0) {
+      pendingExpectedEnds--;
+    }
+  }
+
