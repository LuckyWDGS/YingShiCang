+
+final class MpvHeaderOptions {
+
+  private static final String OPT_HTTP_HEADER_FIELDS = "http-header-fields";
+  private static final String OPT_REFERRER = "referrer";
+
+  static void apply(MediaItem item, OptionWriter writer) {
+    MpvRequestHeaders.Headers headers = MpvRequestHeaders.from(item);
+    if (headers.userAgent() != null) {
+      writer.set(OPT_USER_AGENT, headers.userAgent());
+    }
+    if (headers.referrer() != null) {
+      writer.set(OPT_REFERRER, headers.referrer());
+    }
+    String headerFields = headers.mpvHeaderFields();
+    if (!headerFields.isEmpty()) {
+      writer.set(OPT_HTTP_HEADER_FIELDS, headerFields);
+    }
+  }
+
+  interface OptionWriter {
+
+    void set(String name, String value);
+  }
+}
