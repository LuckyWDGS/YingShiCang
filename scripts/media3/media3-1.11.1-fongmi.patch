+package androidx.media3.ui.danmaku;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.robolectric.Shadows.shadowOf;
+
+import android.graphics.Color;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+/** Regression tests for immediate items and paused seeking. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 34, manifest = Config.NONE)
+public final class DanmakuViewTest {
+
+  private DanmakuView view;
+
+  @Before
+  public void setUp() {
+    view = new DanmakuView(RuntimeEnvironment.getApplication());
+    view.layout(0, 0, 1920, 1080);
+    view.start(0);
+  }
+
+  @Test
+  public void seekWhilePaused_clearsVisibleItemsAndRequestsRedraw() {
+    view.sendNow("before seek");
+    assertThat(view.getActiveItemCount()).isEqualTo(1);
+    view.pause();
+    shadowOf(view).clearWasInvalidated();
+
+    view.seekTo(1_000);
+
+    assertThat(view.isPaused()).isTrue();
+    assertThat(view.getActiveItemCount()).isEqualTo(0);
+    assertThat(shadowOf(view).wasInvalidated()).isTrue();
+  }
+
+  @Test
+  public void sendText_withScrollingHidden_doesNotDisplayItem() {
+    view.setConfig(new DanmakuConfig.Builder().setShowScroll(false).build());
+
+    view.sendNow("hidden scroll");
+
+    assertThat(view.getActiveItemCount()).isEqualTo(0);
+  }
+
+  @Test
+  public void sendItem_withDisplayTypesHidden_doesNotDisplayItems() {
+    view.setConfig(
+        new DanmakuConfig.Builder()
+            .setShowTop(false)
+            .setShowBottom(false)
+            .setShowReverse(false)
+            .setShowPositioned(false)
+            .build());
+
+    view.sendNow(new Danmaku("top", 0, Danmaku.TYPE_TOP, Color.WHITE));
+    view.sendNow(new Danmaku("bottom", 0, Danmaku.TYPE_BOTTOM, Color.WHITE));
+    view.sendNow(new Danmaku("reverse", 0, Danmaku.TYPE_REVERSE, Color.WHITE));
+    view.sendNow(
+        new Danmaku(
+            "positioned", 0, 0.5f, 0.5f, Color.WHITE, 0, 0, Danmaku.POOL_NORMAL, "", 0));
+
+    assertThat(view.getActiveItemCount()).isEqualTo(0);
+  }
+
+  @Test
+  public void sendItem_withSourcePoolsHidden_doesNotDisplayItems() {
+    view.setConfig(
+        new DanmakuConfig.Builder().setShowSubtitle(false).setShowSpecial(false).build());
+
+    view.sendNow(
+        new Danmaku(
+            "subtitle", 0, Danmaku.TYPE_SCROLL, Color.WHITE, 0, Danmaku.POOL_SUBTITLE, "", 0));
+    view.sendNow(
+        new Danmaku("special", 0, Danmaku.TYPE_SCROLL, Color.WHITE, 0, Danmaku.POOL_SPECIAL, "", 0));
+
+    assertThat(view.getActiveItemCount()).isEqualTo(0);
+  }
+
+  @Test
+  public void sendWhilePaused_aboveLimit_keepsExistingItemsAndStaysBounded() {
+    view.setConfig(new DanmakuConfig.Builder().setMaxOnScreen(3).build());
+    view.pause();
+    view.sendNow("first");
+    DanmakuRenderItem first = view.getFirstActiveItem();
+
+    for (int i = 0; i < 1_000; i++) {
+      view.sendNow("item " + i);
+    }
+
+    assertThat(view.isPaused()).isTrue();
+    assertThat(view.getActiveItemCount()).isEqualTo(3);
+    assertThat(view.getFirstActiveItem()).isSameInstanceAs(first);
+  }
+}
