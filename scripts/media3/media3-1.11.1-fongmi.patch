+package androidx.media3.ui.danmaku;
+
+import static org.junit.Assert.*;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.zip.GZIPInputStream;
+import java.util.zip.GZIPOutputStream;
+import org.junit.Test;
+
+public final class BoundedDanmakuInputTest {
+  @Test public void exactLimitIsAccepted() throws Exception {
+    byte[] data = new byte[32];
+    assertArrayEquals(data, BoundedDanmakuInput.read(new ByteArrayInputStream(data), 32));
+  }
+  @Test public void unknownLengthOverLimitIsRejected() {
+    assertThrows(IOException.class,
+        () -> BoundedDanmakuInput.read(new ByteArrayInputStream(new byte[33]), 32));
+  }
+  @Test public void decompressedSizeIsBounded() throws Exception {
+    ByteArrayOutputStream compressed = new ByteArrayOutputStream();
+    try (GZIPOutputStream gzip = new GZIPOutputStream(compressed)) {
+      gzip.write(new byte[65536]);
+    }
+    assertTrue(compressed.size() < 1024);
+    try (GZIPInputStream input = new GZIPInputStream(new ByteArrayInputStream(compressed.toByteArray()))) {
+      assertThrows(IOException.class, () -> BoundedDanmakuInput.read(input, 1024));
+    }
+  }
+  @Test public void cancellationPreservesInterruptFlag() {
+    Thread.currentThread().interrupt();
+    try {
+      assertThrows(IOException.class,
+          () -> BoundedDanmakuInput.read(new ByteArrayInputStream(new byte[8]), 32));
+      assertTrue(Thread.currentThread().isInterrupted());
+    } finally {
+      Thread.interrupted();
+    }
+  }
+}
