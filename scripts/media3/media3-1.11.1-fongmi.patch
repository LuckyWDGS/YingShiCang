+        && compositionObject.cropHeight <= bitmapHeight - compositionObject.cropY;
+  }
+
+  private boolean decodeBitmapData(PgsBitmapObject bitmapObject, int[] colors) {
+    long pixelCountLong = (long) bitmapObject.width() * bitmapObject.height();
+    if (pixelCountLong > Integer.MAX_VALUE) {
