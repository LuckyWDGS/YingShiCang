+package androidx.media3.exoplayer.source.iso;
+
+import static com.google.common.base.Preconditions.checkNotNull;
+
+import androidx.media3.common.CacheDataReader;
+import androidx.media3.common.MediaItem;
+import androidx.media3.extractor.iso.sacd.SacdTocParser;
+import androidx.media3.extractor.iso.udf.UdfFileSystem;
+import java.io.IOException;
+
+final class IsoUtil {
+
+  static final String[] BDMV_INDEX_PATHS = {"BDMV/index.bdmv", "BDMV/INDEX.BDM"};
+
+  static boolean isBluray(UdfFileSystem udf) {
+    for (String path : BDMV_INDEX_PATHS) {
+      try {
+        if (udf.findFile(path) != null) {
+          return true;
+        }
+      } catch (IOException ignored) {
+      }
+    }
+    return false;
+  }
+
+  static boolean isSacd(CacheDataReader isoReader) {
+    try {
+      return SacdTocParser.isSacd(isoReader);
+    } catch (IOException ignored) {
+      return false;
+    }
+  }
+
+  static String childCacheKey(MediaItem mediaItem, String childKey) {
+    MediaItem.LocalConfiguration localConfiguration = checkNotNull(mediaItem.localConfiguration);
+    String parentKey =
+        localConfiguration.customCacheKey != null
+            ? localConfiguration.customCacheKey
+            : localConfiguration.uri.toString();
+    return "iso:" + parentKey.length() + ":" + parentKey + ":" + childKey;
+  }
+}
diff --git a/libraries/exoplayer/src/main/java/androidx/media3/exoplayer/source/iso/SacdSourceHelper.java b/libraries/exoplayer/src/main/java/androidx/media3/exoplayer/source/iso/SacdSourceHelper.java
