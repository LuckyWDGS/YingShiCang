+  protected static long parseTicks(
+      XmlPullParser xpp, String name, long defaultValue, long timescale) {
+    String value = xpp.getAttributeValue(null, name);
+    if (value == null) {
+      return defaultValue;
+    }
+    value = value.replace(',', '.');
+    return value.startsWith("P") || value.startsWith("-P")
+        ? Util.scaleLargeTimestamp(Util.parseXsDuration(value), timescale, C.MILLIS_PER_SECOND)
+        : Long.parseLong(value);
+  }
