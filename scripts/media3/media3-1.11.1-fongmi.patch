+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package androidx.media3.ui.danmaku;
+
+import android.graphics.Paint;
+
+/** Caches the shadow layer applied to a paint. */
+final class ShadowPaintState {
+
+  private int color;
+  private float radius = -1f;
+  private boolean set;
+
+  void apply(Paint paint, int color, float radius) {
+    if (this.color != color || this.radius != radius) {
+      paint.setShadowLayer(radius, 0, 0, color);
+      this.color = color;
+      this.radius = radius;
+      set = true;
+    }
+  }
+
+  void clearIfSet(Paint paint) {
+    if (set) {
+      paint.clearShadowLayer();
+      set = false;
+      radius = -1f;
+    }
+  }
+
+  void invalidate() {
+    radius = -1f;
+  }
+}
