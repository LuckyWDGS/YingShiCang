+extern "C" JNIEXPORT void JNICALL
+Java_androidx_media3_decoder_ffmpeg_FfmpegVideoDecoder_ffmpegReleaseFrame(
+    JNIEnv *, jclass, jlong jFrame) {
+  auto *frame = reinterpret_cast<AVFrame *>(jFrame);
