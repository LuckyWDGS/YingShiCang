+package androidx.media3.datasource;
+
+import static java.lang.Math.min;
+
+import android.net.Uri;
+import androidx.annotation.Nullable;
+import androidx.media3.common.C;
+import androidx.media3.common.PlaybackException;
+import com.hierynomus.msdtyp.AccessMask;
+import com.hierynomus.mssmb2.SMB2CreateDisposition;
+import com.hierynomus.mssmb2.SMB2ShareAccess;
+import com.hierynomus.smbj.SMBClient;
+import com.hierynomus.smbj.auth.AuthenticationContext;
+import com.hierynomus.smbj.connection.Connection;
+import com.hierynomus.smbj.session.Session;
+import com.hierynomus.smbj.share.DiskShare;
+import com.hierynomus.smbj.share.File;
+import java.io.IOException;
+import java.util.EnumSet;
+import java.util.function.Supplier;
+
+public class SmbDataSource extends BaseDataSource {
+
+  private static final int MAX_READ_RECONNECTS = 1;
+
+  private final Supplier<SMBClient> clientFactory;
+
+  @Nullable private Session session;
+  @Nullable private SMBClient smbClient;
+  @Nullable private DiskShare diskShare;
+  @Nullable private Connection connection;
+  @Nullable private Uri uri;
+  @Nullable private File smbFile;
+  @Nullable private String cachedHost;
+  @Nullable private String cachedShare;
+  @Nullable private String cachedFilePath;
+  @Nullable private String cachedUserInfo;
+
+  private boolean opened;
+  private int cachedPort;
+  private long fileLength;
+  private long readPosition;
+  private long bytesRemaining;
+
+  public SmbDataSource() {
+    this(SMBClient::new);
+  }
+
+  SmbDataSource(Supplier<SMBClient> clientFactory) {
+    super(true);
+    this.clientFactory = clientFactory;
+  }
+
+  static AuthenticationContext getAuthentication(Uri uri) {
+    String userInfo = uri.getEncodedUserInfo();
+    if (userInfo == null) {
+      return AuthenticationContext.guest();
+    }
+    String[] parts = userInfo.split(":", 2);
+    String username = Uri.decode(parts[0]);
+    String domain = null;
+    int domainSeparator = username.indexOf(';');
+    if (domainSeparator > 0 && domainSeparator < username.length() - 1) {
+      domain = username.substring(0, domainSeparator);
+      username = username.substring(domainSeparator + 1);
+    }
+    char[] password = parts.length > 1 ? Uri.decode(parts[1]).toCharArray() : new char[0];
+    return new AuthenticationContext(username, password, domain);
+  }
+
+  @Override
+  public long open(DataSpec dataSpec) throws IOException {
+    uri = dataSpec.uri;
+    transferInitializing(dataSpec);
+    String host = uri.getHost();
+    if (host == null) {
+      throw new DataSourceException(PlaybackException.ERROR_CODE_IO_UNSPECIFIED);
+    }
+    int port = uri.getPort() != -1 ? uri.getPort() : 445;
+    String path = uri.getPath();
+    if (path != null && path.startsWith("/")) {
+      path = path.substring(1);
+    }
+    if (path == null || !path.contains("/")) {
+      throw new DataSourceException(PlaybackException.ERROR_CODE_IO_UNSPECIFIED);
+    }
+    String[] parts = path.split("/", 2);
+    String shareName = parts[0];
+    String filePath = parts[1];
+    boolean sameFile =
+        host.equals(cachedHost)
+            && port == cachedPort
+            && shareName.equals(cachedShare)
+            && filePath.equals(cachedFilePath);
+    // Preserve the separator boundary: a%3Ab:c and a:b%3Ac are different identities.
+    String userInfo = uri.getEncodedUserInfo();
+    sameFile = sameFile && java.util.Objects.equals(userInfo, cachedUserInfo);
+    if (!sameFile || smbFile == null) {
+      closeSmb();
+      try {
+        connectSmb(uri, host, port, shareName, filePath, userInfo);
+      } catch (IOException | RuntimeException e) {
+        closeSmb();
+        throw new DataSourceException(e, PlaybackException.ERROR_CODE_IO_NETWORK_CONNECTION_FAILED);
+      }
+    }
+    readPosition = dataSpec.position;
+    if (dataSpec.length != C.LENGTH_UNSET) {
+      bytesRemaining = dataSpec.length;
+    } else {
+      bytesRemaining = fileLength - dataSpec.position;
+    }
+    if (bytesRemaining < 0 || dataSpec.position > fileLength) {
+      closeSmb();
+      throw new DataSourceException(PlaybackException.ERROR_CODE_IO_READ_POSITION_OUT_OF_RANGE);
+    }
+    opened = true;
+    transferStarted(dataSpec);
+    return bytesRemaining;
+  }
+
+  @Override
+  public int read(byte[] buffer, int offset, int length) throws IOException {
+    if (length == 0) {
+      return 0;
+    }
+    if (bytesRemaining == 0) {
+      return C.RESULT_END_OF_INPUT;
+    }
+    if (smbFile == null) {
+      throw new DataSourceException(PlaybackException.ERROR_CODE_IO_UNSPECIFIED);
+    }
+    int bytesToRead = (int) min(bytesRemaining, length);
+    int bytesRead = C.RESULT_END_OF_INPUT;
+    IOException lastError = null;
+    for (int attempt = 0; attempt <= MAX_READ_RECONNECTS; attempt++) {
+      try {
+        bytesRead = smbFile.read(buffer, readPosition, offset, bytesToRead);
+        if (bytesRead > 0 || attempt == MAX_READ_RECONNECTS) break;
+      } catch (IOException | RuntimeException e) {
+        lastError = e instanceof IOException ? (IOException) e : new IOException(e);
+        if (attempt == MAX_READ_RECONNECTS) break;
+      }
+      if (!reconnect()) break;
+    }
+    if (lastError != null && bytesRead <= 0) {
+      throw new DataSourceException(lastError, PlaybackException.ERROR_CODE_IO_NETWORK_CONNECTION_FAILED);
+    }
+    if (bytesRead <= 0) {
+      return C.RESULT_END_OF_INPUT;
+    }
+    readPosition += bytesRead;
+    bytesRemaining -= bytesRead;
+    bytesTransferred(bytesRead);
+    return bytesRead;
+  }
+
+  @Nullable
+  @Override
+  public Uri getUri() {
+    return uri;
+  }
+
+  @Override
+  public void close() throws IOException {
+    uri = null;
+    if (opened) {
+      opened = false;
+      transferEnded();
+    }
+    // DefaultDataSource reuses its SMB delegate across loads. Close the
+    // SMB handle and transport here so a seek, failed load, or player teardown
+    // cannot leave a socket/session alive until the next unrelated open.
+    closeSmb();
+  }
+
+  public void release() {
+    closeSmb();
+  }
+
+  private void connectSmb(Uri sourceUri, String host, int port, String shareName, String filePath,
+      @Nullable String userInfo) throws IOException {
+    smbClient = clientFactory.get();
+    connection = smbClient.connect(host, port);
+    session = connection.authenticate(getAuthentication(sourceUri));
+    diskShare = (DiskShare) session.connectShare(shareName);
+    smbFile =
+        diskShare.openFile(
+            filePath,
+            EnumSet.of(AccessMask.GENERIC_READ),
+            null,
+            EnumSet.of(SMB2ShareAccess.FILE_SHARE_READ),
+            SMB2CreateDisposition.FILE_OPEN,
+            null);
+    fileLength = smbFile.getFileInformation().getStandardInformation().getEndOfFile();
+    cachedHost = host;
+    cachedPort = port;
+    cachedShare = shareName;
+    cachedFilePath = filePath;
+    cachedUserInfo = userInfo;
+  }
+
+  private boolean reconnect() {
+    if (uri == null || cachedHost == null || cachedShare == null || cachedFilePath == null) {
+      return false;
+    }
+    String host = cachedHost;
+    int port = cachedPort;
+    String shareName = cachedShare;
+    String filePath = cachedFilePath;
+    String userInfo = cachedUserInfo;
+    Uri sourceUri = uri;
+    closeSmb();
+    try {
+      connectSmb(sourceUri, host, port, shareName, filePath, userInfo);
+      return true;
+    } catch (IOException | RuntimeException ignored) {
+      closeSmb();
+      return false;
+    }
+  }
+
+  private void closeSmb() {
+    closeSilently(smbFile);
+    closeSilently(diskShare);
+    closeSilently(session);
+    closeSilently(connection);
+    closeSilently(smbClient);
+    cachedPort = -1;
+    smbFile = null;
+    session = null;
+    diskShare = null;
+    smbClient = null;
+    connection = null;
+    cachedHost = null;
+    cachedShare = null;
+    cachedFilePath = null;
+    cachedUserInfo = null;
+  }
+
+  private static void closeSilently(@Nullable AutoCloseable resource) {
+    if (resource != null) {
+      try {
+        resource.close();
+      } catch (Exception ignored) {
+      }
+    }
+  }
+}
