+    bitmapObject.resetReader(bitmapDataReader);
+    int index = 0;
+    while (index < pixelCount) {
+      if (bitmapDataReader.bytesLeft() == 0) {
+        return false;
+      }
+      int colorIndex = bitmapDataReader.readUnsignedByte();
+      if (colorIndex != 0) {
