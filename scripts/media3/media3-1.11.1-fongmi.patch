diff --git a/libraries/common/src/main/java/androidx/media3/common/text/LetterSpacingSpan.java b/libraries/common/src/main/java/androidx/media3/common/text/LetterSpacingSpan.java
new file mode 100644
index 0000000..e988244
--- /dev/null
+++ b/libraries/common/src/main/java/androidx/media3/common/text/LetterSpacingSpan.java
@@ -0,0 +1,86 @@
+/*
