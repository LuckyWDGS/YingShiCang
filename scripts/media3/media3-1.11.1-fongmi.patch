diff --git a/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/media/MpvLoadOptionsFactory.java b/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/media/MpvLoadOptionsFactory.java
