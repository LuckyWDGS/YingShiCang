+package androidx.media3.datasource;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.*;
+
+import android.net.Uri;
+import androidx.media3.common.C;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import com.hierynomus.smbj.SMBClient;
+import com.hierynomus.smbj.auth.AuthenticationContext;
+import com.hierynomus.smbj.connection.Connection;
+import com.hierynomus.smbj.session.Session;
+import com.hierynomus.smbj.share.DiskShare;
+import com.hierynomus.smbj.share.File;
+import java.io.IOException;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@RunWith(AndroidJUnit4.class)
+public final class SmbDataSourceTest {
+  @Test public void encodedCredentialsAndDomain() {
+    AuthenticationContext auth = SmbDataSource.getAuthentication(
+        Uri.parse("smb://WORK%3Buser%3Aname:p%3Ass%40word@host/share/file"));
+    assertThat(auth.getDomain()).isEqualTo("WORK");
+    assertThat(auth.getUsername()).isEqualTo("user:name");
+    assertThat(new String(auth.getPassword())).isEqualTo("p:ss@word");
+  }
+
+  @Test public void passwordMayBeAbsent() {
+    AuthenticationContext auth = SmbDataSource.getAuthentication(Uri.parse("smb://user@host/s/f"));
+    assertThat(auth.getUsername()).isEqualTo("user");
+    assertThat(auth.getPassword()).isEmpty();
+  }
+
+  @Test public void encodedColonDoesNotAliasAnotherIdentity() throws Exception {
+    Fixture f = new Fixture();
+    f.source.open(new DataSpec.Builder().setUri("smb://a%3Ab:c@host/share/file").build());
+    f.source.open(new DataSpec.Builder().setUri("smb://a:b%3Ac@host/share/file").build());
+    verify(f.connection, times(2)).authenticate(any());
+    verify(f.file).close();
+    f.source.close();
+  }
+
+  @Test public void closeReleasesAllHandlesAndIsIdempotent() throws Exception {
+    Fixture f = new Fixture();
+    assertThat(f.source.open(f.spec(0))).isEqualTo(16);
+    f.source.close();
+    f.source.close();
+    verify(f.file).close();
+    verify(f.share).close();
+    verify(f.session).close();
+    verify(f.connection).close();
+    verify(f.client).close();
+  }
+
+  @Test public void authenticationRuntimeFailureClosesPartialTransport() throws Exception {
+    Fixture f = new Fixture();
+    when(f.connection.authenticate(any())).thenThrow(new IllegalStateException("rejected"));
+    assertThrows(DataSourceException.class, () -> f.source.open(f.spec(0)));
+    verify(f.connection).close();
+    verify(f.client).close();
+  }
+
+  @Test public void invalidPositionReleasesOpenFile() throws Exception {
+    Fixture f = new Fixture();
+    assertThrows(DataSourceException.class, () -> f.source.open(f.spec(17)));
+    verify(f.file).close();
+    verify(f.client).close();
+  }
+
+  @Test public void exactEndOfFileIsReadableAsEof() throws Exception {
+    Fixture f = new Fixture();
+    assertThat(f.source.open(f.spec(16))).isEqualTo(0);
+    assertThat(f.source.read(new byte[4], 0, 4)).isEqualTo(C.RESULT_END_OF_INPUT);
+    f.source.close();
+  }
+
+  @Test public void transientReadFailureReconnectsOnce() throws Exception {
+    Fixture f = new Fixture();
+    when(f.file.read(any(), anyLong(), anyInt(), anyInt()))
+        .thenThrow(new IOException("transport reset"))
+        .thenReturn(4);
+    f.source.open(f.spec(0));
+    assertThat(f.source.read(new byte[4], 0, 4)).isEqualTo(4);
+    verify(f.connection, times(2)).authenticate(any());
+    f.source.close();
+  }
+
+  @Test public void oneCloseFailureDoesNotLeakRemainingResources() throws Exception {
+    Fixture f = new Fixture();
+    f.source.open(f.spec(0));
+    doThrow(new IllegalStateException("close failed")).when(f.file).close();
+    f.source.close();
+    verify(f.share).close();
+    verify(f.session).close();
+    verify(f.connection).close();
+    verify(f.client).close();
+  }
+
+  private static final class Fixture {
+    final SMBClient client = mock(SMBClient.class);
+    final Connection connection = mock(Connection.class);
+    final Session session = mock(Session.class);
+    final DiskShare share = mock(DiskShare.class);
+    final File file = mock(File.class, RETURNS_DEEP_STUBS);
+    final SmbDataSource source = new SmbDataSource(() -> client);
+    Fixture() throws Exception {
+      when(client.connect(anyString(), anyInt())).thenReturn(connection);
+      when(connection.authenticate(any())).thenReturn(session);
+      when(session.connectShare(anyString())).thenReturn(share);
+      when(share.openFile(anyString(), any(), any(), any(), any(), any())).thenReturn(file);
+      when(file.getFileInformation().getStandardInformation().getEndOfFile()).thenReturn(16L);
+    }
+    DataSpec spec(long position) {
+      return new DataSpec.Builder().setUri("smb://user:pass@host/share/video.mp4")
+          .setPosition(position).build();
+    }
+  }
+}
