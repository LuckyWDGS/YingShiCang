+      }
+
+      @Override
+      public void runOnPlayerLooperAfterRelease(Runnable runnable) {
+        player.runOnPlayerLooperAfterRelease(runnable);
+      }
+
+      @Override
+      public void onNativeSessionAvailable() {
+        player.onNativeSessionAvailable();
+      }
+    };
+  }
+}
