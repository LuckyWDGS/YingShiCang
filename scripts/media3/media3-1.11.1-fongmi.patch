--- /dev/null
+++ b/libraries/ui_danmaku/src/main/java/androidx/media3/ui/danmaku/BoundedDanmakuInput.java
@@ -0,0 +1,31 @@
+package androidx.media3.ui.danmaku;
+
+import androidx.annotation.RestrictTo;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+
+/** Bounds both downloaded data and expanded compressed segments before parsing. */
+@RestrictTo(RestrictTo.Scope.LIBRARY_GROUP)
+public final class BoundedDanmakuInput {
+  public static final int MAX_BYTES = 32 * 1024 * 1024;
+
+  private BoundedDanmakuInput() {}
+
+  public static byte[] read(InputStream input) throws IOException {
+    return read(input, MAX_BYTES);
+  }
+
+  static byte[] read(InputStream input, int limit) throws IOException {
+    ByteArrayOutputStream output = new ByteArrayOutputStream(Math.min(8192, limit));
+    byte[] buffer = new byte[8192];
+    while (true) {
+      if (Thread.currentThread().isInterrupted()) throw new IOException("Danmaku load canceled");
+      int size = input.read(buffer);
+      if (size == -1) break;
+      if (size > limit - output.size()) throw new IOException("Danmaku input exceeds size limit");
+      output.write(buffer, 0, size);
+    }
+    return output.toByteArray();
+  }
+}
