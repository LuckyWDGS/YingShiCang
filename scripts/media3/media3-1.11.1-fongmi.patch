+package androidx.media3.ui.danmaku.fetcher;
+
+import androidx.media3.common.util.Util;
+import androidx.media3.ui.danmaku.BoundedDanmakuInput;
+import com.google.common.collect.ImmutableMap;
+import java.io.IOException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Map;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+
+final class FetcherUtil {
+
+  static final String UA =
+      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko)"
+          + " Chrome/139.0.0.0 Safari/537.36";
+
+  static ImmutableMap<String, String> headers(String origin, String referer) {
+    return ImmutableMap.of("Origin", origin, "Referer", referer, "User-Agent", UA);
+  }
+
+  static String md5Hex(String input) throws IOException {
+    try {
+      return Util.toHexString(MessageDigest.getInstance("MD5").digest(Util.getUtf8Bytes(input)));
+    } catch (NoSuchAlgorithmException e) {
+      throw new IOException("MD5 not available", e);
+    }
+  }
+
+  static String fetchString(OkHttpClient client, String url, Map<String, String> headers)
+      throws IOException {
+    return Util.fromUtf8Bytes(fetchBytes(client, url, headers));
+  }
+
+  static byte[] fetchBytes(OkHttpClient client, String url, Map<String, String> headers)
+      throws IOException {
+    Request.Builder requestBuilder = new Request.Builder().url(url);
+    for (Map.Entry<String, String> header : headers.entrySet()) {
+      requestBuilder.header(header.getKey(), header.getValue());
+    }
+    try (Response response = client.newCall(requestBuilder.build()).execute()) {
+      if (!response.isSuccessful()) {
+        throw new IOException("Danmaku HTTP " + response.code());
+      }
+      if (response.body() == null) throw new IOException("Empty danmaku response");
+      if (response.body().contentLength() > BoundedDanmakuInput.MAX_BYTES) {
+        throw new IOException("Danmaku input exceeds size limit");
+      }
+      return BoundedDanmakuInput.read(response.body().byteStream());
+    }
+  }
+
+  /** Cancels calls owned by the per-source client used for a segmented session. */
+  static void cancel(OkHttpClient client) {
+    client.dispatcher().cancelAll();
+  }
+}
